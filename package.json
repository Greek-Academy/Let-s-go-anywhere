{
  "name": "driveplus-mobile-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.x",
    "npm": "11.19.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "capture:ui": "node scripts/capture-ui.mjs",
    "format": "prettier --write src tests tools scripts build firebase .github CONTRIBUTING.md *.ts *.json index.html",
    "format:check": "prettier --check src tests tools scripts build firebase .github CONTRIBUTING.md *.ts *.json index.html",
    "verify:preview": "node scripts/verify-preview.mjs",
    "test:preview": "node scripts/test-preview.mjs",
    "review": "vite --config review.vite.config.ts",
    "build:review": "vite build --config review.vite.config.ts",
    "preview:review": "vite preview --config review.vite.config.ts",
    "test:review": "playwright test --config playwright.review.config.ts",
    "content:check": "node scripts/check-content.mjs",
    "release:backup": "node scripts/release-backup.mjs",
    "test:release-backup": "node --test scripts/release-backup.test.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios --no-sync",
    "research": "node tools/spot-research/server.mjs",
    "research:demo": "node tools/spot-research/server.mjs --demo",
    "test:research": "node --test tools/spot-research/tests/*.test.mjs",
    "test:research:ui": "playwright test --config playwright.research.config.ts",
    "test:discovery-search": "playwright test --config playwright.discovery-search.config.ts",
    "dev:firebase": "vite --mode firebase --host 127.0.0.1 --port 5182 --strictPort",
    "build:firebase": "tsc -b && vite build --mode firebase",
    "test:firebase:rules": "firebase emulators:exec --only firestore --project demo-driveplus \"node --test --test-concurrency=1 firebase/tests/*.test.mjs\"",
    "test:firebase:ui": "firebase emulators:exec --only auth,firestore --project demo-driveplus \"playwright test --config playwright.firebase.config.ts\"",
    "firebase:login": "firebase login",
    "ios:copy:firebase": "npm run build:firebase && DRIVEPLUS_IOS_VARIANT=firebase cap copy ios",
    "cloudflare:login": "wrangler login",
    "build:search-worker": "WRANGLER_SEND_METRICS=false wrangler deploy --config tools/public-search/wrangler.json --dry-run --outdir .worker-build",
    "test:public-search": "npm run build:search-worker && node --test tools/public-search/*.test.mjs",
    "test:dogfood": "firebase emulators:exec --only auth --project demo-driveplus \"playwright test --config playwright.dogfood.config.ts\"",
    "dogfood:prepare": "node scripts/prepare-dogfood.mjs",
    "dogfood:hosting": "node scripts/prepare-dogfood-hosting.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@mapbox/vector-tile": "3.0.0",
    "firebase": "12.19.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.52.0",
    "pbf": "5.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "15.32.1",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.9.9",
    "typescript": "~5.9.2",
    "vite": "^8.3.2",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    }
  }
}
