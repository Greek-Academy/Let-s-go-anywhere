{
  "name": "driveplus-mobile-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.x",
    "npm": "11.19.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "capture:ui": "node scripts/capture-ui.mjs",
    "format": "prettier --write src tests tools scripts build .github CONTRIBUTING.md *.ts *.json index.html",
    "format:check": "prettier --check src tests tools scripts build .github CONTRIBUTING.md *.ts *.json index.html",
    "verify:preview": "node scripts/verify-preview.mjs",
    "test:preview": "node scripts/test-preview.mjs",
    "review": "vite --config review.vite.config.ts",
    "build:review": "vite build --config review.vite.config.ts",
    "preview:review": "vite preview --config review.vite.config.ts",
    "test:review": "playwright test --config playwright.review.config.ts",
    "content:check": "node scripts/check-content.mjs",
    "release:backup": "node scripts/release-backup.mjs",
    "test:release-backup": "node --test scripts/release-backup.test.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios --no-sync"
  },
  "dependencies": {
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "lucide-react": "^1.45.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "3.9.6",
    "typescript": "~5.9.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
