rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function validList(uid, slot) {
      let d = request.resource.data;
      return slot in ['1', '2', '3']
        && d.keys().hasAll(['schemaVersion', 'ownerId', 'name', 'color', 'revision', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'ownerId', 'name', 'color', 'revision', 'createdAt', 'updatedAt'])
        && d.schemaVersion == 1 && d.ownerId == uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.name.matches('.*[^\\s].*')
        && d.color in ['teal', 'blue', 'peach']
        && d.revision is int && d.revision >= 1
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    // Owner-only preparation remains separate from explicitly shared lists.
    match /wishlistDrafts/{uid}/lists/{slot} {
      allow read: if verifiedOwner(uid);
      allow create: if verifiedOwner(uid) && validList(uid, slot)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time;
      allow update: if verifiedOwner(uid) && validList(uid, slot)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if verifiedOwner(uid);
    }

    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function named(v, max) { return v is string && v.size() >= 1 && v.size() <= max && v.matches('.*[^\\s].*'); }
    function token(v) { return v is string && v.matches('^[a-f0-9]{64}$'); }
    function lid(v) { return v is string && v.matches('^[a-f0-9]{32}$'); }
    function lp(id) { return /databases/$(database)/documents/sharedLists/$(id); }
    function ip(id, key) { return /databases/$(database)/documents/sharedLists/$(id)/items/$(key); }
    function vp(id, key) { return /databases/$(database)/documents/sharedLists/$(id)/invitations/$(key); }
    function sp(uid, slot) { return /databases/$(database)/documents/sharedCreationSlots/$(uid)/slots/$(slot); }
    function member(l) { return verified() && request.auth.uid in l.memberIds; }
    function owner(l) { return member(l) && l.ownerId == request.auth.uid; }
    function active(l) { return member(l) && l.status == 'active'; }
    function bump(d, old) { return d.revision == old.revision + 1 && d.updatedAt == request.time; }
    function baseList(d) {
      return d.keys().hasAll(['schemaVersion','creatorId','slot','ownerId','name','color','members','memberIds','successorId','currentInvite','status','cleanupUid','cleanupVersion','cleanedCount','itemCount','inviteCount','action','target','revision','createdAt','updatedAt'])
        && d.keys().hasOnly(['schemaVersion','creatorId','slot','ownerId','name','color','members','memberIds','successorId','currentInvite','status','cleanupUid','cleanupVersion','cleanedCount','itemCount','inviteCount','action','target','revision','createdAt','updatedAt'])
        && d.schemaVersion == 1 && d.creatorId is string && d.slot in ['1','2','3'] && d.ownerId is string
        && named(d.name,40) && d.color in ['teal','blue','peach']
        && d.members is map && d.memberIds is list && d.memberIds.size() >= 1 && d.memberIds.size() <= 5
        && d.memberIds.toSet().size() == d.memberIds.size() && d.members.keys().toSet() == d.memberIds.toSet()
        && d.ownerId in d.memberIds
        && (d.successorId == null || (d.successorId in d.memberIds && d.successorId != d.ownerId))
        && (d.currentInvite == null || token(d.currentInvite))
        && d.status in ['active','cleaning','deleting'] && (d.cleanupUid == null || d.cleanupUid is string)
        && d.cleanupVersion is int && d.cleanupVersion >= 0 && d.cleanedCount is int && d.cleanedCount >= 0 && d.cleanedCount <= 100
        && d.itemCount is int && d.itemCount >= 0 && d.itemCount <= 100 && d.inviteCount is int && d.inviteCount >= 0 && d.inviteCount <= 10
        && d.action is string && d.target is string && d.target.size() <= 128
        && d.revision is int && d.revision >= 1 && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function fields(d, old, extras) { return d.diff(old).affectedKeys().hasOnly(extras.concat(['action','target','revision','updatedAt'])); }
    function invitationLive(l, key, v) {
      return l.status == 'active' && l.currentInvite == key && l.ownerId == v.ownerId
        && request.time < v.createdAt + duration.value(7,'d');
    }
    function validApprove(id, d, old) {
      let v = get(vp(id,old.currentInvite)).data;
      return invitationLive(old,old.currentInvite,v) && v.status == 'requested' && v.applicantId == d.target
        && !(d.target in old.memberIds) && named(v.applicantName,30)
        && d.members.diff(old.members).affectedKeys().hasOnly([d.target])
        && d.members.keys().size() == old.members.keys().size()+1 && d.members[d.target] == v.applicantName
        && getAfter(vp(id,old.currentInvite)).data.status == 'used';
    }
    function validRemove(d, old) {
      return d.target in old.memberIds && d.target != old.ownerId
        && (owner(old) || d.target == request.auth.uid)
        && d.members.diff(old.members).affectedKeys().hasOnly([d.target])
        && !(d.target in d.members) && d.members.keys().size() == old.members.keys().size()-1
        && d.status == 'cleaning' && d.cleanupUid == d.target && d.cleanupVersion == d.revision && d.cleanedCount == 0
        && d.currentInvite == null && d.successorId == null;
    }
    function listChange(id, d, old) {
      return (d.action == 'edit' && active(old) && owner(old) && fields(d,old,['name','color']))
        || (d.action == 'invite' && active(old) && owner(old) && old.memberIds.size() < 5
          && fields(d,old,['currentInvite','inviteCount']) && d.currentInvite == d.target && token(d.target)
          && d.inviteCount == old.inviteCount+1 && !exists(vp(id,d.target))
          && getAfter(vp(id,d.target)).data.status == 'open')
        || (d.action == 'revoke' && active(old) && owner(old) && fields(d,old,['currentInvite'])
          && old.currentInvite == d.target && d.currentInvite == null && getAfter(vp(id,d.target)).data.status == 'revoked')
        || (d.action == 'approve' && active(old) && owner(old) && fields(d,old,['members','memberIds']) && validApprove(id,d,old))
        || (d.action == 'removeMember' && active(old) && fields(d,old,['members','memberIds','status','cleanupUid','cleanupVersion','cleanedCount','currentInvite','successorId']) && validRemove(d,old))
        || (d.action == 'offerTransfer' && active(old) && owner(old) && fields(d,old,['successorId'])
          && (d.successorId == null || (d.target == d.successorId && d.target in old.memberIds && d.target != old.ownerId)))
        || (d.action == 'acceptTransfer' && active(old) && old.successorId == request.auth.uid
          && fields(d,old,['ownerId','successorId','currentInvite']) && d.ownerId == request.auth.uid && d.successorId == null && d.currentInvite == null)
        || (d.action == 'addItem' && active(old) && fields(d,old,['itemCount']) && token(d.target)
          && d.itemCount == old.itemCount+1 && !exists(ip(id,d.target)) && existsAfter(ip(id,d.target)))
        || (d.action == 'removeItem' && active(old) && fields(d,old,['itemCount']) && token(d.target)
          && d.itemCount == old.itemCount-1 && exists(ip(id,d.target)) && !existsAfter(ip(id,d.target)))
        || (d.action == 'cleanItem' && owner(old) && old.status == 'cleaning' && fields(d,old,['cleanedCount']) && token(d.target)
          && d.cleanedCount == old.cleanedCount+1 && d.cleanedCount <= old.itemCount
          && get(ip(id,d.target)).data.cleanVersion < old.cleanupVersion && getAfter(ip(id,d.target)).data.cleanVersion == old.cleanupVersion)
        || (d.action == 'cleanupDone' && owner(old) && old.status == 'cleaning' && fields(d,old,['status','cleanupUid'])
          && old.cleanedCount == old.itemCount && old.inviteCount == 0 && d.status == 'active' && d.cleanupUid == null)
        || (d.action == 'delete' && owner(old) && fields(d,old,['status','currentInvite','successorId'])
          && d.status == 'deleting' && d.currentInvite == null && d.successorId == null)
        || (d.action == 'deleteItem' && owner(old) && old.status == 'deleting' && fields(d,old,['itemCount']) && token(d.target)
          && d.itemCount == old.itemCount-1 && exists(ip(id,d.target)) && !existsAfter(ip(id,d.target)))
        || (d.action == 'pruneInvite' && owner(old) && fields(d,old,['inviteCount']) && token(d.target)
          && old.currentInvite != d.target && d.inviteCount == old.inviteCount-1 && exists(vp(id,d.target)) && !existsAfter(vp(id,d.target)));
    }
    match /sharedCreationSlots/{uid}/slots/{slot} {
      allow read: if verifiedOwner(uid);
      allow create: if verifiedOwner(uid) && slot in ['1','2','3'] && request.resource.data.keys().hasOnly(['listId'])
        && lid(request.resource.data.listId) && getAfter(lp(request.resource.data.listId)).data.creatorId == uid
        && getAfter(lp(request.resource.data.listId)).data.slot == slot && !exists(lp(request.resource.data.listId));
      allow delete: if verified() && owner(get(lp(resource.data.listId)).data) && !existsAfter(lp(resource.data.listId));
    }
    match /sharedLists/{id} {
      allow read: if member(resource.data);
      allow create: if verified() && lid(id) && baseList(request.resource.data)
        && request.resource.data.creatorId == request.auth.uid && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid] && named(request.resource.data.members[request.auth.uid],30)
        && request.resource.data.successorId == null && request.resource.data.currentInvite == null && request.resource.data.status == 'active'
        && request.resource.data.cleanupUid == null && request.resource.data.cleanupVersion == 0 && request.resource.data.cleanedCount == 0
        && request.resource.data.itemCount == 0 && request.resource.data.inviteCount == 0 && request.resource.data.action == 'create' && request.resource.data.target == ''
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && !exists(sp(request.auth.uid,request.resource.data.slot)) && getAfter(sp(request.auth.uid,request.resource.data.slot)).data.listId == id;
      allow update: if verified() && baseList(request.resource.data) && bump(request.resource.data,resource.data)
        && listChange(id,request.resource.data,resource.data);
      allow delete: if owner(resource.data) && resource.data.status == 'deleting' && resource.data.itemCount == 0 && resource.data.inviteCount == 0
        && !existsAfter(sp(resource.data.creatorId,resource.data.slot));
      match /invitations/{key} {
        function group() { return get(lp(id)).data; }
        function nextGroup() { return getAfter(lp(id)).data; }
        function shape(v) {
          return token(key) && v.keys().hasAll(['ownerId','ownerName','listName','status','applicantId','applicantName','revision','createdAt','updatedAt'])
            && v.keys().hasOnly(['ownerId','ownerName','listName','status','applicantId','applicantName','revision','createdAt','updatedAt'])
            && v.ownerId is string && named(v.ownerName,30) && named(v.listName,40)
            && v.status in ['open','requested','used','revoked'] && v.revision is int && v.revision >= 1 && v.createdAt is timestamp && v.updatedAt == request.time
            && (v.applicantId == null || v.applicantId is string) && (v.applicantName == null || named(v.applicantName,30));
        }
        allow get: if verified() && (owner(group()) || (member(group()) && resource.data.status == 'used')
          || (invitationLive(group(),key,resource.data) && (resource.data.status == 'open' || (resource.data.status == 'requested' && resource.data.applicantId == request.auth.uid))));
        allow list: if owner(group());
        allow create: if active(group()) && owner(group()) && shape(request.resource.data)
          && nextGroup().action == 'invite' && nextGroup().target == key && nextGroup().revision == group().revision+1 && nextGroup().currentInvite == key
          && request.resource.data.ownerId == request.auth.uid && request.resource.data.ownerName == group().members[request.auth.uid] && request.resource.data.listName == group().name
          && request.resource.data.status == 'open' && request.resource.data.applicantId == null && request.resource.data.applicantName == null
          && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
        allow update: if verified() && shape(request.resource.data) && bump(request.resource.data,resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','applicantId','applicantName','revision','updatedAt'])
          && ((resource.data.status == 'open' && request.resource.data.status == 'requested' && invitationLive(group(),key,resource.data)
              && !(request.auth.uid in group().memberIds) && group().memberIds.size() < 5 && request.resource.data.applicantId == request.auth.uid && named(request.resource.data.applicantName,30))
            || (resource.data.status == 'requested' && request.resource.data.status == 'open' && resource.data.applicantId == request.auth.uid
              && request.resource.data.applicantId == null && request.resource.data.applicantName == null && invitationLive(group(),key,resource.data))
            || (resource.data.status == 'requested' && request.resource.data.status == 'used' && owner(group()) && invitationLive(group(),key,resource.data)
              && request.resource.data.applicantId == resource.data.applicantId && request.resource.data.applicantName == resource.data.applicantName
              && nextGroup().action == 'approve' && nextGroup().target == resource.data.applicantId && nextGroup().revision == group().revision+1
              && resource.data.applicantId in nextGroup().memberIds)
            || (request.resource.data.status == 'revoked' && owner(group()) && nextGroup().action == 'revoke' && nextGroup().target == key
              && nextGroup().revision == group().revision+1 && nextGroup().currentInvite == null && request.resource.data.applicantId == null && request.resource.data.applicantName == null));
        allow delete: if owner(group()) && group().currentInvite != key && nextGroup().action == 'pruneInvite' && nextGroup().target == key
          && nextGroup().revision == group().revision+1 && nextGroup().inviteCount == group().inviteCount-1;
      }
      match /items/{key} {
        function group() { return get(lp(id)).data; }
        function nextGroup() { return getAfter(lp(id)).data; }
        function candidate(c) {
          return c is map && c.keys().hasAll(['kind','catalogId','title','area','url','status','sample','capturedAt'])
            && c.keys().hasOnly(['kind','catalogId','title','area','url','status','sample','capturedAt'])
            && ((c.kind == 'catalog' && c.catalogId is string && c.catalogId.matches('^[a-zA-Z0-9_-]{1,100}$') && c.sample == true && c.url == null)
              || (c.kind in ['web','link'] && c.catalogId == null && c.url is string))
            && named(c.title,300) && c.area is string && c.area.size() <= 300
            && (c.url == null || (c.url is string && c.url.size() <= 2048 && c.url.matches('https?://[^\\s]+')))
            && named(c.status,160) && c.sample is bool && c.capturedAt is string
            && c.capturedAt.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,3})?Z$');
        }
        function shape(d) {
          return token(key) && d.keys().hasAll(['candidate','note','authorId','reactions','cleanVersion','revision','createdAt','updatedAt'])
            && d.keys().hasOnly(['candidate','note','authorId','reactions','cleanVersion','revision','createdAt','updatedAt'])
            && candidate(d.candidate) && d.note is string && d.note.size() <= 300 && (d.authorId == null || d.authorId is string)
            && d.reactions is map && d.reactions.size() <= 5 && d.cleanVersion is int && d.cleanVersion >= 0
            && d.revision is int && d.revision >= 1 && d.createdAt is timestamp && d.updatedAt == request.time;
        }
        function paired(action) { return nextGroup().action == action && nextGroup().target == key && nextGroup().revision == group().revision+1; }
        function clean(d, old) {
          return owner(group()) && group().status == 'cleaning' && paired('cleanItem')
            && old.cleanVersion < group().cleanupVersion && d.cleanVersion == group().cleanupVersion
            && d.diff(old).affectedKeys().hasOnly(['authorId','reactions','cleanVersion','revision','updatedAt'])
            && d.authorId == (old.authorId == group().cleanupUid ? null : old.authorId)
            && d.reactions.diff(old.reactions).affectedKeys().hasOnly([group().cleanupUid]) && !(group().cleanupUid in d.reactions);
        }
        allow read: if active(group()) || owner(group());
        allow create: if active(group()) && shape(request.resource.data) && paired('addItem')
          && nextGroup().itemCount == group().itemCount+1 && request.resource.data.authorId == request.auth.uid && request.resource.data.reactions.size() == 0
          && request.resource.data.cleanVersion == 0 && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
        allow update: if verified() && shape(request.resource.data) && bump(request.resource.data,resource.data)
          && ((active(group()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note','revision','updatedAt'])
              && (resource.data.authorId == request.auth.uid || (resource.data.authorId == null && owner(group()))))
            || (active(group()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions','revision','updatedAt'])
              && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
              && (!(request.auth.uid in request.resource.data.reactions) || request.resource.data.reactions[request.auth.uid] in ['want','interested','pass']))
            || clean(request.resource.data,resource.data));
        allow delete: if (active(group()) && (owner(group()) || resource.data.authorId == request.auth.uid) && paired('removeItem') && nextGroup().itemCount == group().itemCount-1)
          || (owner(group()) && group().status == 'deleting' && paired('deleteItem') && nextGroup().itemCount == group().itemCount-1);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
